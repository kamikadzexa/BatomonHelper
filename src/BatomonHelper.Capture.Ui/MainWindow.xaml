<Window x:Class="BatomonHelper.Capture.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Batomon Helper — Guided Profile Capture" Width="980" Height="760" MinWidth="820" MinHeight="620">
  <Grid Margin="18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock FontSize="22" FontWeight="Bold" Text="Read-only profile capture" />
    <TextBlock Grid.Row="1" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#4E5D6D" Text="Read game screen captures only the visible Batomon client area while it is in front. The image and OCR text are discarded immediately; no game input or memory writes occur." />
    <Border Grid.Row="2" Margin="0,14,0,12" Padding="14" Background="#EAF3FF" BorderBrush="#8DB8E8" BorderThickness="1" CornerRadius="5">
      <StackPanel>
        <TextBlock FontWeight="Bold" Text="{Binding Progress}" />
        <TextBlock Margin="0,4,0,10" TextWrapping="Wrap" FontSize="15" Text="{Binding NextGameInstruction}" />
        <WrapPanel><Button Content="Read game screen" Command="{Binding ReadScreenCommand}" Padding="14,6" Margin="0,0,8,0"/><Button Content="{Binding PrimaryActionLabel}" Command="{Binding PrimaryCommand}" Padding="14,6" FontWeight="Bold" /></WrapPanel>
      </StackPanel>
    </Border>
    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,14,0">
        <GroupBox Header="Review visible shop values" Padding="9">
          <WrapPanel>
            <StackPanel><TextBlock Text="Day"/><TextBox Text="{Binding Day, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel><TextBlock Text="Shop rank"/><TextBox Text="{Binding ShopRank, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel><TextBlock Text="Gold"/><TextBox Text="{Binding Gold, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel><TextBlock Text="Wins"/><TextBox Text="{Binding Wins, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel><TextBlock Text="Lives"/><TextBox Text="{Binding Lives, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel><TextBlock Text="Free rerolls"/><TextBox Text="{Binding FreeRerolls, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel><TextBlock Text="Locked (0/1)"/><TextBox Text="{Binding IsShopLocked, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel><TextBlock Text="Team count"/><TextBox Text="{Binding TeamCount, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel><TextBlock Text="Bench count"/><TextBox Text="{Binding BenchCount, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel><TextBlock Text="Shop count"/><TextBox Text="{Binding ShopCount, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
          </WrapPanel>
        </GroupBox>
        <GroupBox Header="OCR review — edit fields above before continuing" Padding="7" Margin="0,12,0,0"><DataGrid ItemsSource="{Binding RecognizedFields}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="155"><DataGrid.Columns><DataGridTextColumn Header="Field" Binding="{Binding Field}" Width="*"/><DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="70"/><DataGridTextColumn Header="Confidence" Binding="{Binding Confidence, StringFormat={}{0:P0}}" Width="90"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="130"/></DataGrid.Columns></DataGrid></GroupBox>
        <GroupBox Header="Resume existing capture" Padding="8" Margin="0,12,0,0"><DockPanel><Button DockPanel.Dock="Right" Content="Resume session" Command="{Binding LoadSessionCommand}" Margin="8,0,0,0"/><TextBox Text="{Binding SessionPath, UpdateSourceTrigger=PropertyChanged}" /></DockPanel></GroupBox>
      </StackPanel>
      <StackPanel Grid.Column="1">
        <GroupBox Header="Candidate counts" Padding="6"><DataGrid ItemsSource="{Binding CapturedFields}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="250"><DataGrid.Columns><DataGridTextColumn Header="Field" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Expected" Binding="{Binding Expected}" Width="72"/><DataGridTextColumn Header="Candidates" Binding="{Binding CandidateCount}" Width="86"/></DataGrid.Columns></DataGrid></GroupBox>
        <GroupBox Header="Advanced read-only tools" Padding="8" Margin="0,12,0,0"><StackPanel><TextBlock TextWrapping="Wrap" Text="Use only at the Resolve step after filtering a field to one candidate." /><DockPanel Margin="0,7,0,0"><ComboBox Width="150" ItemsSource="{Binding CapturedFields}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedField}"/><Button Content="Find module paths" Command="{Binding FindPointersCommand}" Margin="7,0,0,0"/></DockPanel><Button Content="Observe candidates" Command="{Binding ObserveCommand}" Margin="0,7,0,0" HorizontalAlignment="Left"/></StackPanel></GroupBox>
      </StackPanel>
    </Grid>
    <Border Grid.Row="4" Margin="0,12,0,0" Padding="8" Background="#F4F6F8" CornerRadius="4"><TextBlock TextWrapping="Wrap" Text="{Binding Status}" /></Border>
  </Grid>
</Window>
