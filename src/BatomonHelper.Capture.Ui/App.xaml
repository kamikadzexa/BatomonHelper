<Application x:Class="BatomonHelper.Capture.Ui.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <Style TargetType="TextBox"><Setter Property="Margin" Value="3"/><Setter Property="MinWidth" Value="68"/></Style>
    <Style TargetType="Button"><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="10,5"/></Style>
