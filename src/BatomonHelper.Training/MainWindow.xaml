<Window x:Class="BatomonHelper.Training.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Pantra Training Lab" Width="1320" Height="920" MinWidth="1080" MinHeight="680">
 <Window.Resources>
  <Style x:Key="LegacySetting" TargetType="FrameworkElement"><Style.Triggers><DataTrigger Binding="{Binding SelectedIndex,ElementName=TrainingEngine}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style>
  <DataTemplate x:Key="DamagePanel">
   <Expander DataContext="{Binding Owner}" Header="Board DPS, stacking and time to target HP" IsExpanded="True" Margin="4,10">
    <StackPanel>
     <WrapPanel><TextBlock Text="Target HP override (blank = upcoming battle base HP)" VerticalAlignment="Center"/><TextBox Text="{Binding TargetHp,UpdateSourceTrigger=PropertyChanged}" Width="95"/><Button Content="Recalculate" Click="ReanalyzeBoard"/></WrapPanel>
     <TextBlock Text="{Binding DamageSummary}" TextWrapping="Wrap" Margin="0,5" Foreground="#8DDABF"/>
     <Viewbox Stretch="Uniform" MaxHeight="180"><Canvas Width="600" Height="160" Background="#152536"><Polyline Points="{Binding DamageCurve}" Stroke="#8DDABF" StrokeThickness="2"/><Polyline Points="{Binding HpLine}" Stroke="#FFCE79" StrokeThickness="1" StrokeDashArray="5 3"/></Canvas></Viewbox>
     <TextBlock Text="Cumulative damage (green) · target HP (gold) · 0–30 seconds" Foreground="#A7BBD0"/>
     <DataGrid ItemsSource="{Binding DamageRows}" SelectedIndex="0" AutoGenerateColumns="False" IsReadOnly="True" RowDetailsVisibilityMode="VisibleWhenSelected" MaxHeight="440">
      <DataGrid.Columns><DataGridTextColumn Header="Time" Binding="{Binding Time}"/><DataGridTextColumn Header="DPS" Binding="{Binding Dps}"/><DataGridTextColumn Header="Damage / range" Binding="{Binding Damage}"/><DataGridTextColumn Header="Direct" Binding="{Binding Direct}"/><DataGridTextColumn Header="Burn" Binding="{Binding Burn}"/><DataGridTextColumn Header="Poison" Binding="{Binding Poison}"/><DataGridTextColumn Header="Shock" Binding="{Binding Shock}"/><DataGridTextColumn Header="Active stacks" Binding="{Binding Stacks}"/></DataGrid.Columns>
      <DataGrid.RowDetailsTemplate><DataTemplate><StackPanel Margin="8"><TextBlock Text="{Binding Stacks}" Foreground="#FFCE79" TextWrapping="Wrap"/><TextBlock Text="{Binding Units}" TextWrapping="Wrap"/></StackPanel></DataTemplate></DataGrid.RowDetailsTemplate>
     </DataGrid>
     <TextBlock Text="Select a time row to inspect effective stats and effect activation / growth counters." Foreground="#A7BBD0" TextWrapping="Wrap"/>
     <TextBlock Text="{Binding DamageLimits}" Foreground="#A7BBD0" TextWrapping="Wrap" Margin="0,5"/>
    </StackPanel>
   </Expander>
  </DataTemplate>
  <DataTemplate x:Key="Card"><Border Background="#203246" BorderBrush="#3D5A70" BorderThickness="1" CornerRadius="6" Margin="4" Padding="9">
   <Grid MinHeight="116"><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Image Source="{Binding Sprite}" Width="52" Height="52" RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Uniform"/>
    <StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Level}" Foreground="#FFCE79" Margin="0,3"/>
     <TextBlock Text="{Binding Types}" Foreground="#8DDABF" FontSize="11" TextWrapping="Wrap"/><TextBlock Text="{Binding Stats}" FontSize="11" TextWrapping="Wrap" Margin="0,3"/>
    </StackPanel>
   </Grid>
  </Border></DataTemplate>
  <DataTemplate x:Key="PlayCard">
   <Border Background="#203246" BorderBrush="#3D5A70" BorderThickness="1" CornerRadius="7" Margin="4" Padding="8"
           AllowDrop="True" Cursor="Hand"
           PreviewMouseLeftButtonDown="PlayCardMouseDown" PreviewMouseMove="PlayCardMouseMove"
           DragOver="PlayCardDragOver" Drop="PlayCardDrop" MouseLeftButtonUp="PlayCardMouseUp">
    <Grid MinHeight="116"><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Image Source="{Binding Sprite}" Width="52" Height="52" RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Uniform"/>
     <StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Level}" Foreground="#FFCE79" Margin="0,3"/>
      <TextBlock Text="{Binding Types}" Foreground="#8DDABF" FontSize="11" TextWrapping="Wrap"/><TextBlock Text="{Binding Stats}" FontSize="11" TextWrapping="Wrap" Margin="0,3"/>
     </StackPanel>
    </Grid>
   </Border>
  </DataTemplate>
  <DataTemplate x:Key="PlayActionButton">
   <Button Tag="{Binding Action}" Click="PlayActionButtonClick" Margin="3" Padding="10,7" MinWidth="132" MaxWidth="310" Background="#29445A" Foreground="#EAF0F6" BorderBrush="#4F708C" BorderThickness="1" ToolTip="{Binding Description}">
    <StackPanel Orientation="Horizontal"><Image Source="{Binding Icon}" Width="28" Height="28" Margin="0,0,7,0" RenderOptions.BitmapScalingMode="NearestNeighbor"/><TextBlock Text="{Binding Description}" TextWrapping="Wrap" MaxWidth="250"/></StackPanel>
   </Button>
  </DataTemplate>
 </Window.Resources>
 <Grid Margin="18" Background="#101D2A"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="Pantra Training Lab" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Standalone simulation · strategic shop planning · complete normal runs" Foreground="#A7BBD0" Margin="0,4,0,12"/></StackPanel>
   <TextBlock Grid.Column="1" Text="{Binding RulesLabel}" Foreground="#A7BBD0" VerticalAlignment="Center"/>
  </Grid>
  <Border Grid.Row="1" Background="#27384A" CornerRadius="6" Padding="12" Margin="0,0,0,12"><TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#FFCE79"/></Border>
  <TabControl x:Name="Tabs" Grid.Row="2" Background="#101D2A" BorderBrush="#3D5A70">
   <TabItem Header="Training"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
    <WrapPanel>
     <StackPanel Width="160"><TextBlock Text="Device"/><ComboBox x:Name="Device" SelectedIndex="0"><ComboBoxItem Content="auto"/><ComboBoxItem Content="cpu"/><ComboBoxItem Content="cuda"/></ComboBox></StackPanel>
     <StackPanel Width="120" Style="{StaticResource LegacySetting}"><TextBlock Text="Worker ceiling"/><TextBox x:Name="Workers" Text="16"/></StackPanel>
     <StackPanel Width="150" Style="{StaticResource LegacySetting}"><TextBlock Text="Environment ceiling"/><TextBox x:Name="Environments" Text="1024"/></StackPanel>
     <StackPanel Width="140" Style="{StaticResource LegacySetting}"><TextBlock Text="PPO batch ceiling"/><TextBox x:Name="Minibatch" Text="2048"/></StackPanel>
     <StackPanel Width="150"><TextBlock Text="Seed"/><TextBox x:Name="Seed" Text="69"/></StackPanel>
     <StackPanel Width="160"><TextBlock Text="Minutes (0 = until stopped)"/><TextBox x:Name="Minutes" Text="0"/></StackPanel>
     <CheckBox x:Name="AutoCalibrate" Style="{StaticResource LegacySetting}" IsChecked="True" Content="Auto-calibrate new sessions" Foreground="#EAF0F6" VerticalAlignment="Center" Margin="8,18,0,0"/>
    </WrapPanel>
    <TextBlock Text="Output directory"/><TextBox x:Name="Output" Text="{Binding OutputDirectory, Mode=OneWay}"/>
    <WrapPanel><TextBlock Text="Learning method" VerticalAlignment="Center"/><ComboBox x:Name="TrainingEngine" SelectedIndex="0" Width="310"><ComboBoxItem Content="Strategic search + expert iteration"/><ComboBoxItem Content="Legacy PPO (comparison only)"/></ComboBox><TextBlock Text="Strategic sessions use complete runs and a separate checkpoint format." VerticalAlignment="Center" Foreground="#A7BBD0"/></WrapPanel>
    <WrapPanel><WrapPanel.Style><Style TargetType="WrapPanel"><Style.Triggers><DataTrigger Binding="{Binding SelectedIndex,ElementName=TrainingEngine}" Value="1"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></WrapPanel.Style>
     <StackPanel Width="150"><TextBlock Text="Teacher warmup runs"/><TextBox x:Name="WarmupRuns" Text="32"/></StackPanel>
     <StackPanel Width="160"><TextBlock Text="Training search seconds"/><TextBox x:Name="SearchSeconds" Text="0.15"/></StackPanel>
     <StackPanel Width="160"><TextBlock Text="Evaluation search seconds"/><TextBox x:Name="EvaluationSeconds" Text="2"/></StackPanel>
    </WrapPanel>
    <WrapPanel Margin="0,10,0,12"><Button Content="Start" Click="Start"/><Button Content="Pause" Click="Pause"/><Button Content="Resume" Click="Resume"/><Button Content="Stop and save" Click="Stop"/><CheckBox x:Name="ThoroughEvaluation" Content="Thorough (512 runs)" Foreground="#EAF0F6" VerticalAlignment="Center"/><Button Content="Evaluate current" Click="Evaluate"/><Button Content="Rank generations" Click="RankGenerations"/><Button Content="Export current" Click="Export"/><Button Content="Export selected" Click="ExportSelected"/></WrapPanel>
    <Border Background="#203246" CornerRadius="6" Padding="18"><StackPanel><TextBlock Text="{Binding Progress}" FontSize="18" TextWrapping="Wrap"/><TextBlock Text="{Binding Checkpoint}" Foreground="#A7BBD0" Margin="0,10" TextWrapping="Wrap"/>
     <Polyline Points="{Binding Curve}" Stroke="#8DDABF" StrokeThickness="2" Height="110" Stretch="Fill" Margin="0,10"/><TextBlock Text="Episode success over updates (includes curriculum starts)" Foreground="#A7BBD0"/>
    </StackPanel></Border>
    <TextBlock Text="Training episodes (full and suffix starts; use fixed evaluation to compare strength)" FontWeight="SemiBold" FontSize="17" Margin="0,18,0,8"/>
    <DataGrid ItemsSource="{Binding GenerationResults}" AutoGenerateColumns="True" MaxHeight="220"/>
    <TextBlock Text="Fixed evaluation leaderboard" FontWeight="SemiBold" FontSize="17" Margin="0,18,0,8"/>
    <DataGrid x:Name="RankingList" ItemsSource="{Binding RankingResults}" AutoGenerateColumns="True" MaxHeight="260"/>
    <TextBlock Text="User-session fights — separate evaluation results (sampled first when available)" FontWeight="SemiBold" FontSize="17" Margin="0,18,0,8"/>
    <DataGrid ItemsSource="{Binding UserSessionComparisons}" AutoGenerateColumns="True" MaxHeight="110"/>
    <TextBlock Text="Trainer results" FontWeight="SemiBold" FontSize="17" Margin="0,18,0,8"/>
    <DataGrid ItemsSource="{Binding TrainerResults}" AutoGenerateColumns="True" MaxHeight="250"/>
    <Expander Header="Rules coverage" Foreground="#EAF0F6" Margin="0,18"><DataGrid ItemsSource="{Binding Issues}" AutoGenerateColumns="True" Height="280"/></Expander>
    <Expander Header="Rule provenance and labelled guesses" Foreground="#EAF0F6" Margin="0,10"><StackPanel>
     <DataGrid ItemsSource="{Binding Evidence}" AutoGenerateColumns="True" Height="260"/>
     <TextBlock Text="Base team HP — supplied values and estimates" Margin="0,12,0,4"/><DataGrid ItemsSource="{Binding HpEvidence}" AutoGenerateColumns="True" Height="180"/>
     <TextBlock Text="Daily base income — supplied values and estimates" Margin="0,12,0,4"/><DataGrid ItemsSource="{Binding IncomeEvidence}" AutoGenerateColumns="True" Height="180"/>
    </StackPanel></Expander>
    <Expander Header="Diagnostic tools" Foreground="#EAF0F6" Margin="0,12"><StackPanel><CheckBox x:Name="Diagnostic" Foreground="#FFCE79" Content="Use the synthetic diagnostic fixture — this does not train a Batomon policy" Margin="0,8"/>
     <TextBlock Text="Guessed mechanics are allowed and labelled separately. Missing executable handlers still block game training. Diagnostic runs exercise the learner, checkpoints and history viewer." Foreground="#A7BBD0" TextWrapping="Wrap"/>
    </StackPanel></Expander>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="History"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <WrapPanel>
     <StackPanel Width="230"><TextBlock Text="View"/><ComboBox x:Name="HistoryView" SelectedIndex="0"><ComboBoxItem Content="Recent runs"/><ComboBoxItem Content="Best examples (curated, not performance)"/></ComboBox></StackPanel>
     <StackPanel Width="85"><TextBlock Text="Generation"/><TextBox x:Name="GenerationFilter"/></StackPanel>
     <StackPanel Width="85"><TextBlock Text="Policy"/><TextBox x:Name="PolicyFilter"/></StackPanel>
     <StackPanel Width="170"><TextBlock Text="Trainer ID"/><TextBox x:Name="TrainerFilter"/></StackPanel>
     <StackPanel Width="125"><TextBlock Text="Outcome"/><ComboBox x:Name="OutcomeFilter" SelectedIndex="0"><ComboBoxItem Content="All"/><ComboBoxItem Content="Success"/><ComboBoxItem Content="Failure"/></ComboBox></StackPanel>
     <StackPanel Width="145"><TextBlock Text="Source"/><ComboBox x:Name="SourceFilter" SelectedIndex="0"><ComboBoxItem Content="All"/><ComboBoxItem Content="Training"/><ComboBoxItem Content="Evaluation"/></ComboBox></StackPanel>
     <Button Content="Refresh" Click="RefreshHistory" VerticalAlignment="Center"/>
    </WrapPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="490"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <DataGrid x:Name="RunList" ItemsSource="{Binding Runs}" SelectionChanged="SelectRun" AutoGenerateColumns="False" HeadersVisibility="Column">
     <DataGrid.Columns><DataGridTextColumn Header="Gen" Binding="{Binding Generation}" Width="40"/><DataGridTextColumn Header="Policy" Binding="{Binding Policy}" Width="45"/><DataGridTextColumn Header="Trainer" Binding="{Binding Trainer}" Width="155"/><DataGridTextColumn Header="Wins" Binding="{Binding Wins}" Width="45"/><DataGridTextColumn Header="Turns left" Binding="{Binding TurnsRemaining}" Width="70"/><DataGridTextColumn Header="Days" Binding="{Binding Days}" Width="40"/><DataGridTextColumn Header="Outcome" Binding="{Binding Outcome}" Width="65"/><DataGridCheckBoxColumn Header="Eval" Binding="{Binding Evaluation}" Width="40"/></DataGrid.Columns>
     </DataGrid>
     <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel>
      <TextBlock Text="{Binding SelectedRunLabel}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="4,0,0,10"/>
      <WrapPanel><Button Content="Previous day" Click="PreviousDay"/><Button Content="Next day" Click="NextDay"/><Button Content="Pin / unpin" Click="TogglePin"/><CheckBox x:Name="ShowOpponent" Content="Opponent board" Foreground="#EAF0F6" Checked="ChangeBoard" Unchecked="ChangeBoard" VerticalAlignment="Center"/></WrapPanel>
      <TextBlock Text="{Binding DayLabel}" Foreground="#FFCE79" TextWrapping="Wrap" Margin="4,12"/>
      <TextBlock Text="TEAM" FontWeight="SemiBold" Margin="4,6"/>
      <ItemsControl ItemsSource="{Binding Team}" ItemTemplate="{StaticResource Card}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
      <TextBlock Text="BENCH" FontWeight="SemiBold" Margin="4,12,4,6"/>
      <ItemsControl ItemsSource="{Binding Bench}" ItemTemplate="{StaticResource Card}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
      <TextBlock Text="{Binding Inventory}" TextWrapping="Wrap" Margin="4,12" Foreground="#A7BBD0"/>
      <TextBlock Text="{Binding Decisions}" TextWrapping="Wrap" Margin="4,8"/>
      <ContentControl Content="{Binding AnalysisView}" ContentTemplate="{StaticResource DamagePanel}"/>
     </StackPanel></ScrollViewer>
    </Grid>
   </Grid></TabItem>
   <TabItem Header="Play Session"><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="390"/></Grid.ColumnDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="4">
    <WrapPanel><StackPanel Width="200"><TextBlock Text="Trainer"/><ComboBox x:Name="PlayTrainer"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="#101D2A"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
     <StackPanel Width="130"><TextBlock Text="Session seed"/><TextBox x:Name="PlaySeed" Text="69"/></StackPanel>
     <Button Content="New session" Click="NewPlaySession"/><Button Content="Save session" Click="SavePlaySession"/>
    </WrapPanel>
    <TextBlock Text="{Binding PlayInfo}" FontSize="18" TextWrapping="Wrap" Margin="4,12" Foreground="#FFCE79"/>
    <TextBlock Text="{Binding PlayResult}" TextWrapping="Wrap" Margin="4,6"/>
    <TextBlock Text="TEAM · slots 1–6" FontWeight="SemiBold"/>
    <ItemsControl ItemsSource="{Binding PlayTeam}" ItemTemplate="{StaticResource PlayCard}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
    <TextBlock Text="BENCH · slots 7–10" FontWeight="SemiBold" Margin="0,8,0,0"/>
    <ItemsControl ItemsSource="{Binding PlayBench}" ItemTemplate="{StaticResource PlayCard}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
    <TextBlock Text="SHOP · icons identify creatures and usable items; click an offer to buy" FontWeight="SemiBold" Margin="0,8,0,0"/>
    <ItemsControl ItemsSource="{Binding PlayShop}" ItemTemplate="{StaticResource PlayCard}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
    <TextBlock Text="{Binding PlayInventory}" TextWrapping="Wrap" Margin="4,10"/>
    <WrapPanel><Button Content="Plan shop (30s)" Click="RecommendPlay"/><Button Content="Cancel planning" Click="CancelAdvice"/><Button Content="Apply recommendation" Click="ApplyRecommendation"/></WrapPanel>
    <TextBlock Text="{Binding PlayAdvice}" TextWrapping="Wrap" Foreground="#FFCE79" Margin="4,8"/>
    <ContentControl Content="{Binding AnalysisView}" ContentTemplate="{StaticResource DamagePanel}"/>
    <Border Background="#182B3B" BorderBrush="#3D5A70" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,4,0,12">
     <StackPanel><TextBlock Text="Manual controls" FontSize="16" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding PlayInteractionHint}" Foreground="#FFCE79" TextWrapping="Wrap" Margin="0,4,0,8"/>
      <ItemsControl ItemsSource="{Binding PlayActions}" ItemTemplate="{StaticResource PlayActionButton}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
     </StackPanel>
    </Border>
   </StackPanel></ScrollViewer>
   <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="12,4,0,4">
    <TextBlock Text="Play session" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
    <Border Background="#182B3B" BorderBrush="#3D5A70" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,0,12">
     <StackPanel><TextBlock Text="How to play" FontWeight="SemiBold"/><TextBlock Text="Click a shop card to buy it; if several slots are open, click the empty destination. Drag a team or bench card onto another slot to move or swap it. Merging is automatic when the required matching creatures are on the team or bench. Event and reward buttons explain their effects before you choose. A session ends when you reach the win target, lose all lives, or reach turn 16." TextWrapping="Wrap" Foreground="#A7BBD0" Margin="0,6,0,0"/></StackPanel>
    </Border>
    <TextBlock Text="Battle result" FontWeight="SemiBold" Margin="0,2,0,4"/><TextBlock Text="{Binding PlayResult}" TextWrapping="Wrap" Foreground="#8DDABF" Margin="0,0,0,14"/>
    <TextBlock Text="Your saved sessions · boards are used only as opponents" FontWeight="SemiBold" Margin="0,18,0,8"/>
    <WrapPanel><Button Content="Resume selected" Click="ResumePlaySession"/><Button Content="Inspect battles" Click="InspectPlaySession"/>
     <Button Content="Add to opponent pool" Tag="add" Click="ChangePool"/><Button Content="Remove from pool" Tag="remove" Click="ChangePool"/><Button Content="Enable / disable" Tag="toggle" Click="ChangePool"/>
    </WrapPanel>
    <DataGrid x:Name="PlaySessionList" ItemsSource="{Binding PlaySessions}" AutoGenerateColumns="True" IsReadOnly="True" Height="220"/>
   </StackPanel></ScrollViewer></Grid></TabItem>
   <TabItem Header="Board Analysis"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16"><TextBlock Text="Analysis of the most recently selected Play Session or history board" FontSize="18" FontWeight="SemiBold"/><ContentControl Content="{Binding AnalysisView}" ContentTemplate="{StaticResource DamagePanel}"/></StackPanel></ScrollViewer></TabItem>
  </TabControl>
 </Grid>
</Window>
