<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
            <DataTemplate x:Key="BoardCard">
              <Border Background="#1B5D6E" BorderBrush="#5894A2" BorderThickness="1" CornerRadius="5" Padding="8" Margin="3">
                <Grid MinHeight="68"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                  <Image Source="{Binding SpritePath}" Height="48" Width="48" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" Margin="0,0,8,0" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Level}" Foreground="#FFD34D" Margin="0,0,7,0" FontSize="11" /><TextBlock Text="{Binding Variant}" Foreground="#FFD34D" FontSize="11" /></StackPanel>
                    <TextBlock Text="{Binding Stats}" TextWrapping="Wrap" FontSize="11" />
                    <TextBlock Text="{Binding Price}" TextWrapping="Wrap" Foreground="#BCDDE4" FontSize="12" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
    <DataTemplate x:Key="DamagePanel">
      <StackPanel>
        <TextBlock Text="{Binding DamageSummary}" FontWeight="SemiBold" Foreground="#FFD34D" FontSize="15" Margin="0,0,0,10" TextWrapping="Wrap">
          <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding DamageSummary}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
        <Border Background="#164F62" BorderBrush="#73B3C4" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,0,0,10" Visibility="{Binding RecommendedPositionsVisibility}">
          <StackPanel>
            <TextBlock Text="{Binding PositionHint}" TextWrapping="Wrap" Foreground="#E0F5F8" />
            <StackPanel Visibility="{Binding RecommendedPositionsVisibility}">
              <TextBlock Text="FASTEST DPS / WIN" FontWeight="Bold" Foreground="#FFD34D" Margin="0,7,0,2" />
              <TextBlock Text="Yellow positions need a change." Foreground="#FFD34D" FontSize="11" Margin="0,0,0,4" />
              <ItemsControl ItemsSource="{Binding RecommendedTeamRows}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border x:Name="PositionCard" Background="#1B5D6E" BorderBrush="#5894A2" BorderThickness="1" CornerRadius="3" Padding="4" Margin="2">
                      <StackPanel Orientation="Horizontal">
                        <Image Source="{Binding SpritePath}" Height="30" Width="30" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" Margin="0,0,4,0" />
                        <StackPanel>
                          <TextBlock x:Name="PositionName" Text="{Binding Name}" FontSize="11" TextWrapping="Wrap" />
                          <TextBlock x:Name="PositionLevel" Text="{Binding Level}" Foreground="#FFD34D" FontSize="10" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding IsChanged}" Value="True">
                        <Setter TargetName="PositionCard" Property="Background" Value="#FFD34D" />
                        <Setter TargetName="PositionCard" Property="BorderBrush" Value="#FFD34D" />
                        <Setter TargetName="PositionName" Property="Foreground" Value="#17313B" />
                        <Setter TargetName="PositionName" Property="FontWeight" Value="SemiBold" />
                        <Setter TargetName="PositionLevel" Property="Foreground" Value="#17313B" />
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </Border>
        <Expander Header="Team output · 0–30 seconds" IsExpanded="True" Visibility="{Binding DpsCountersVisibility}">
        <StackPanel Visibility="{Binding DpsCountersVisibility}">
        <TextBlock Text="YOUR TEAM OUTPUT" FontWeight="SemiBold" Foreground="#FFD34D" Margin="8,0,0,8" />
        <Grid Margin="8,0,8,5">
          <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <TextBlock Text="PER SECOND" Foreground="#BCDDE4" FontWeight="SemiBold" />
          <TextBlock Grid.Column="1" Text="0s" TextAlignment="Center" Foreground="#BCDDE4" />
          <TextBlock Grid.Column="2" Text="5s" TextAlignment="Center" Foreground="#BCDDE4" />
          <TextBlock Grid.Column="3" Text="10s" TextAlignment="Center" Foreground="#BCDDE4" />
          <TextBlock Grid.Column="4" Text="15s" TextAlignment="Center" Foreground="#BCDDE4" />
          <TextBlock Grid.Column="5" Text="20s" TextAlignment="Center" Foreground="#BCDDE4" />
          <TextBlock Grid.Column="6" Text="30s" TextAlignment="Center" Foreground="#BCDDE4" />
        </Grid>
        <ItemsControl ItemsSource="{Binding DamageRows}" HorizontalContentAlignment="Stretch">
          <ItemsControl.ItemTemplate><DataTemplate>
            <Border BorderBrush="#4D8C9A" BorderThickness="0,1,0,0" Padding="8,9">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Metric}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Second0}" FontSize="13" FontWeight="SemiBold" TextAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding Second5}" FontSize="13" FontWeight="SemiBold" TextAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{Binding Second10}" FontSize="13" FontWeight="SemiBold" TextAlignment="Center" />
                <TextBlock Grid.Column="4" Text="{Binding Second15}" FontSize="13" FontWeight="SemiBold" TextAlignment="Center" />
                <TextBlock Grid.Column="5" Text="{Binding Second20}" FontSize="13" FontWeight="SemiBold" TextAlignment="Center" />
                <TextBlock Grid.Column="6" Text="{Binding Second30}" FontSize="13" FontWeight="SemiBold" TextAlignment="Center" Foreground="#FFD34D" />
              </Grid>
            </Border>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        </StackPanel></Expander>
        <StackPanel>
          <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding OpponentRows.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
        <TextBlock Text="ENEMY" FontWeight="SemiBold" Foreground="#FFD34D" Margin="8,18,0,8" />
        <ItemsControl ItemsSource="{Binding OpponentRows}" ItemTemplate="{StaticResource BoardCard}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
        <Grid Margin="8,0,8,5">
          <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <TextBlock Text="PER SECOND" Foreground="#BCDDE4" FontWeight="SemiBold" />
          <TextBlock Grid.Column="1" Text="0s" TextAlignment="Center" Foreground="#BCDDE4" />
          <TextBlock Grid.Column="2" Text="5s" TextAlignment="Center" Foreground="#BCDDE4" />
          <TextBlock Grid.Column="3" Text="10s" TextAlignment="Center" Foreground="#BCDDE4" />
          <TextBlock Grid.Column="4" Text="15s" TextAlignment="Center" Foreground="#BCDDE4" />
          <TextBlock Grid.Column="5" Text="20s" TextAlignment="Center" Foreground="#BCDDE4" />
          <TextBlock Grid.Column="6" Text="30s" TextAlignment="Center" Foreground="#BCDDE4" />
        </Grid>
        <ItemsControl ItemsSource="{Binding OpponentDamageRows}" HorizontalContentAlignment="Stretch">
          <ItemsControl.ItemTemplate><DataTemplate>
            <Border BorderBrush="#4D8C9A" BorderThickness="0,1,0,0" Padding="8,9">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Metric}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Second0}" FontSize="13" FontWeight="SemiBold" TextAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding Second5}" FontSize="13" FontWeight="SemiBold" TextAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{Binding Second10}" FontSize="13" FontWeight="SemiBold" TextAlignment="Center" />
                <TextBlock Grid.Column="4" Text="{Binding Second15}" FontSize="13" FontWeight="SemiBold" TextAlignment="Center" />
                <TextBlock Grid.Column="5" Text="{Binding Second20}" FontSize="13" FontWeight="SemiBold" TextAlignment="Center" />
                <TextBlock Grid.Column="6" Text="{Binding Second30}" FontSize="13" FontWeight="SemiBold" TextAlignment="Center" Foreground="#FFD34D" />
              </Grid>
            </Border>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        </StackPanel>
      </StackPanel>
    </DataTemplate>

</ResourceDictionary>
