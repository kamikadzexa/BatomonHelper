<Application x:Class="BatomonHelper.Overlay.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="PanelBackground" Color="#E9141A25" />
    <SolidColorBrush x:Key="Accent" Color="#78E2B8" />
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F2F5FA" /></Style>
    <Style TargetType="Button"><Setter Property="Margin" Value="4,0" /><Setter Property="Padding" Value="8,4" /></Style>
  </Application.Resources>
</Application>
