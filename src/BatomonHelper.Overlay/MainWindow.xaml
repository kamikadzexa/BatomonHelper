<Window x:Class="BatomonHelper.Overlay.MainWindow" x:Name="OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Batomon Helper" Icon="pack://application:,,,/BatomonHelper.Overlay;component/Assets/batomon-helper.ico"
        Width="1440" Height="900" MinWidth="960" MinHeight="640" Topmost="True"
        WindowStyle="None" ResizeMode="CanResize" Background="#125F70" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <ResourceDictionary><ResourceDictionary.MergedDictionaries>
      <ResourceDictionary Source="Themes/Dashboard.xaml" />
      <ResourceDictionary Source="Themes/BoardTemplates.xaml" />
    </ResourceDictionary.MergedDictionaries>
      <Style x:Key="InlineNotice" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,4"/>
        <Style.Triggers>
          <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
          <Trigger Property="Text" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </Window.Resources>
  <Border x:Name="ShellRoot" Background="#125F70" SizeChanged="DashboardSizeChanged" BorderBrush="#4D8C9A" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Background="#103F50">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0">
          <Image Source="Assets/batomon-helper-logo.png" Width="24" Height="24" Margin="0,0,10,0"/>
          <TextBlock Text="Batomon Helper" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBlock x:Name="VersionLabel" Foreground="#BCDDE4" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="11"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="MinimizeWindow" ToolTip="Minimize" AutomationProperties.Name="Minimize"/>
          <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="ToggleMaximize" ToolTip="Maximize" AutomationProperties.Name="Maximize"/>
          <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="CloseWindow" ToolTip="Close" AutomationProperties.Name="Close"/>
        </StackPanel>
      </Grid>
      <Border Grid.Row="1" Background="#103F50" BorderBrush="#4D8C9A" BorderThickness="0,1,0,1" Padding="18,12">
        <DockPanel LastChildFill="True">
          <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Refresh  ·  F9" Command="{Binding CaptureShopCommand}"/>
          <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Hide  ·  F8" Margin="0,0,10,0" Click="HideHelper" ToolTip="Hide the helper. Press F8 to show it again."/>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="16,0">
            <CheckBox Content="Auto update" IsChecked="{Binding AutoUpdate, Mode=TwoWay}" ToolTip="Refresh live game state every half second"/>
            <CheckBox Content="Capture run" Margin="20,0,0,0" IsChecked="{Binding CaptureRun, Mode=TwoWay}" IsEnabled="{Binding CanToggleRunCapture}" ToolTip="Start from a clean Day 1 opening to record shop changes and game battle samples for simulator validation"/>
          </StackPanel>
          <StackPanel VerticalAlignment="Center"><TextBlock Text="LIVE COMPANION" FontSize="10" FontWeight="SemiBold" Foreground="#FFD34D"/></StackPanel>
        </DockPanel>
      </Border>
      <Grid Grid.Row="2">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="20,8,20,0">
          <TextBlock Text="{Binding BridgeNotice}" Style="{StaticResource InlineNotice}" Foreground="#E0F5F8" Margin="0,4"/>
          <TextBlock Text="{Binding Warning}" Style="{StaticResource InlineNotice}" Foreground="#FFE18B" Margin="0,2"/>
          <TextBlock Text="{Binding AnalysisWarning}" Style="{StaticResource InlineNotice}" Foreground="#FFE18B" Margin="0,2"/>
          <TextBlock Text="{Binding HotkeyWarning}" Style="{StaticResource InlineNotice}" Foreground="#FFE18B" Margin="0,2"/>
        </StackPanel>
        <TabControl x:Name="BoardTabs" Grid.Row="1" SelectedIndex="0" Style="{StaticResource TopTabs}">
          <TabItem Header="Board" Tag="&#xE80F;">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="0,0,4,12">
                <TextBlock Text="Board overview" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Your team, shop, and battle insights in one place." Style="{StaticResource PageSubtitle}"/>
                <Border Style="{StaticResource Surface}" Margin="0,16,0,16">
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Image Source="{Binding TrainerSpritePath}" Height="64" Width="72" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" Margin="0,0,16,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding BoardSummary}" TextWrapping="Wrap" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding RunSummary}" TextWrapping="Wrap" Foreground="#BCDDE4" Margin="0,6,0,0"/></StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding BattleSummary}" FontSize="28" FontWeight="Bold" Margin="16,0,0,0" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#FFD34D"/><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding BattleSummary}" Value="WIN"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding BattleSummary}" Value="LOSS"><Setter Property="Visibility" Value="Visible"/><Setter Property="Foreground" Value="#FF94B1"/></DataTrigger><DataTrigger Binding="{Binding BattleSummary}" Value="Calculating fight result..."><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                  </Grid>
                </Border>
                <Grid x:Name="BoardColumns">
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <StackPanel>
                    <Border Style="{StaticResource Surface}" Margin="0,0,0,16"><StackPanel>
                      <TextBlock Text="Your team" Foreground="#FF94B1" Style="{StaticResource SectionTitle}"/>
                      <ItemsControl ItemsSource="{Binding TeamRows}" ItemTemplate="{StaticResource BoardCard}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
                    </StackPanel></Border>
                    <Border Style="{StaticResource Surface}" Margin="0,0,0,16"><StackPanel>
                      <TextBlock Text="Bench" Style="{StaticResource SectionTitle}"/>
                      <ItemsControl ItemsSource="{Binding BenchRows}" ItemTemplate="{StaticResource BoardCard}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
                    </StackPanel></Border>
                    <Border Style="{StaticResource Surface}" Margin="0,0,0,16"><StackPanel>
                      <TextBlock Text="Shop" Style="{StaticResource SectionTitle}"/>
                      <ItemsControl ItemsSource="{Binding OfferRows}" ItemTemplate="{StaticResource BoardCard}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
                    </StackPanel></Border>
                  </StackPanel>
                  <Border x:Name="BoardAnalysis" Grid.Column="1" Style="{StaticResource Surface}" Margin="16,0,0,0" VerticalAlignment="Top">
                    <StackPanel><TextBlock Text="Battle insights" Style="{StaticResource SectionTitle}"/>
                      <TextBlock Text="Passive-target output and positioning suggestions" Foreground="#BCDDE4" TextWrapping="Wrap" Margin="0,0,0,16"/>
                      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource DamagePanel}" HorizontalContentAlignment="Stretch"/>
                      <TextBlock Text="Insights appear when game state is available." Foreground="#BCDDE4" TextWrapping="Wrap" Margin="0,8,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DamageRows.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                    </StackPanel>
                  </Border>
                </Grid>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="Creatures" Tag="&#xE8D4;">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
              <StackPanel><TextBlock Text="Creatures" Style="{StaticResource PageTitle}"/><TextBlock Text="Browse the pool and explore your next shop." Style="{StaticResource PageSubtitle}"/></StackPanel>
              <Border Grid.Row="1" Style="{StaticResource Surface}" Margin="0,16,0,12">
                <StackPanel>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="160"/><ColumnDefinition Width="145"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0"><TextBlock Text="Search creatures" Style="{StaticResource FieldLabel}"/><TextBox Style="{StaticResource FilterTextBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search creatures"/></StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Region" Style="{StaticResource FieldLabel}"/><ComboBox Style="{StaticResource FilterComboBox}" ItemsSource="{Binding RegionFilters}" SelectedItem="{Binding SelectedRegionFilter}" DisplayMemberPath="Name" AutomationProperties.Name="Creature region"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="Rarity" Style="{StaticResource FieldLabel}"/><ComboBox Style="{StaticResource FilterComboBox}" ItemsSource="{Binding RarityFilters}" SelectedItem="{Binding SelectedRarityFilter}" DisplayMemberPath="Name" AutomationProperties.Name="Creature rarity"/></StackPanel>
                  </Grid>
                  <WrapPanel Margin="0,14,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Shop rank" VerticalAlignment="Center" Foreground="#BCDDE4" Margin="0,0,12,0"/>
                    <Button Style="{StaticResource OverlayButton}" Content="−" Command="{Binding DecreaseRankCommand}" AutomationProperties.Name="Decrease rank"/>
                    <TextBlock Text="{Binding RankLabel}" MinWidth="72" TextAlignment="Center" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource OverlayButton}" Content="+" Command="{Binding IncreaseRankCommand}" AutomationProperties.Name="Increase rank"/>
                    <CheckBox Content="Item available" IsChecked="{Binding ItemAvailable, Mode=TwoWay}" Margin="18,0" ToolTip="The fifth shop slot is an item"/>
                    <Button Style="{StaticResource OverlayButton}" Content="Reset" Command="{Binding ResetCommand}"/>
                    <TextBlock Text="{Binding CreatureCount}" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#BCDDE4"/>
                  </WrapPanel>
                </StackPanel>
              </Border>
              <Expander Grid.Row="2" Header="{Binding ShopOddsLabel}" Margin="0,0,0,12">
                <Expander.Style><Style TargetType="Expander"><Setter Property="Foreground" Value="#E8EDF2"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="IsExpanded" Value="True"/><Style.Triggers><DataTrigger Binding="{Binding IsCompact, ElementName=OverlayWindow}" Value="True"><Setter Property="IsExpanded" Value="False"/></DataTrigger></Style.Triggers></Style></Expander.Style>
      <Border Margin="0,8,0,0" Padding="10,8" Background="#103F50" BorderBrush="#4D8C9A" BorderThickness="1" CornerRadius="6">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel Width="128" VerticalAlignment="Center" Margin="0,0,10,0">
            <TextBlock FontWeight="SemiBold" FontSize="14" Text="{Binding ShopOddsLabel}" />
            <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="#BCDDE4" Text="Per Batomon slot" />
          </StackPanel>
          <ItemsControl Grid.Column="1" ItemsSource="{Binding ShopOddsRows}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate>
              <Border Margin="3,0" Padding="9,6" Background="#1B5D6E" BorderBrush="#5894A2" BorderThickness="1" CornerRadius="4">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="{Binding Rarity}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,2,0,0" FontSize="10" Foreground="#BCDDE4" Text="{Binding PoolDescription}" />
                  </StackPanel>
                  <TextBlock Grid.Row="1" VerticalAlignment="Center" Margin="0,6,0,0" FontSize="17" FontWeight="Bold" Foreground="#FFD34D" Text="{Binding Percentage}" />
                </Grid>
              </Border>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Border>
              </Expander>
<Grid Grid.Row="3"><DataGrid ItemsSource="{Binding CreatureRows}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="True" HeadersVisibility="Column" Background="#103F50" Foreground="White" BorderThickness="0" CellStyle="{StaticResource GridCell}" RowStyle="{StaticResource CreatureGridRow}" ColumnHeaderStyle="{StaticResource GridHeader}">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="Icon" Width="76" CanUserSort="False"><DataGridTemplateColumn.CellTemplate><DataTemplate><Image Source="{Binding SpritePath}" Style="{StaticResource CatalogIcon}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridCheckBoxColumn ElementStyle="{StaticResource GridCheckBox}" EditingElementStyle="{StaticResource GridCheckBox}" Header="Lv. 3" Binding="{Binding IsLevelThree, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SortMemberPath="IsLevelThree" Width="66" />
                <DataGridTextColumn EditingElementStyle="{StaticResource DarkTextBox}" Header="Creature" Binding="{Binding Name}" SortMemberPath="Name" Width="2*" MinWidth="140" IsReadOnly="True" />
                <DataGridTextColumn ElementStyle="{StaticResource AbilityText}" Header="Ability" Binding="{Binding Ability}" SortMemberPath="Ability" Width="3*" MinWidth="260" IsReadOnly="True" />
                <DataGridTextColumn EditingElementStyle="{StaticResource DarkTextBox}" ElementStyle="{StaticResource RarityText}" Header="Rarity" Binding="{Binding Rarity}" SortMemberPath="RarityOrder" Width="110" IsReadOnly="True" />
                <DataGridTextColumn EditingElementStyle="{StaticResource DarkTextBox}" Header="Region" Binding="{Binding Regions}" SortMemberPath="Regions" Width="140" IsReadOnly="True" />
                <DataGridTextColumn EditingElementStyle="{StaticResource DarkTextBox}" Header="Roll" Binding="{Binding PerRoll}" SortMemberPath="PerRollValue" Width="90" IsReadOnly="True" />
                <DataGridTextColumn EditingElementStyle="{StaticResource DarkTextBox}" Header="Next shop" Binding="{Binding NextShop}" SortMemberPath="NextShopValue" Width="100" IsReadOnly="True" />
              </DataGrid.Columns>
            </DataGrid><TextBlock Style="{StaticResource EmptyResults}" Tag="{Binding CreatureRows.Count}"/></Grid>
            </Grid>
          </TabItem>
          <TabItem Header="Items" Tag="&#xE719;">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
              <StackPanel><TextBlock Text="Items" Style="{StaticResource PageTitle}"/><TextBlock Text="Explore effects, availability, and shop odds." Style="{StaticResource PageSubtitle}"/></StackPanel>
              <Border Grid.Row="1" Style="{StaticResource Surface}" Margin="0,16,0,16">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="160"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,12,0"><TextBlock Text="Search items" Style="{StaticResource FieldLabel}"/><TextBox Style="{StaticResource FilterTextBox}" Text="{Binding ItemSearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search items"/></StackPanel>
                  <StackPanel Grid.Column="1"><TextBlock Text="Rarity" Style="{StaticResource FieldLabel}"/><ComboBox Style="{StaticResource FilterComboBox}" ItemsSource="{Binding RarityFilters}" SelectedItem="{Binding SelectedItemRarityFilter}" DisplayMemberPath="Name" AutomationProperties.Name="Items rarity"/></StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding ItemCount}" Foreground="#BCDDE4" VerticalAlignment="Bottom" Margin="16,0,0,10"/>
                </Grid>
              </Border>
              <Grid Grid.Row="2"><DataGrid ItemsSource="{Binding ItemRows}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="True" HeadersVisibility="Column" Background="#103F50" Foreground="White" BorderThickness="0" CellStyle="{StaticResource GridCell}" RowStyle="{StaticResource GridRow}" ColumnHeaderStyle="{StaticResource GridHeader}">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="Icon" Width="76" CanUserSort="False"><DataGridTemplateColumn.CellTemplate><DataTemplate><Image Source="{Binding SpritePath}" Style="{StaticResource CatalogIcon}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTextColumn EditingElementStyle="{StaticResource DarkTextBox}" Header="Item" Binding="{Binding Name}" SortMemberPath="Name" Width="2*" MinWidth="140" IsReadOnly="True" />
                  <DataGridTextColumn EditingElementStyle="{StaticResource DarkTextBox}" ElementStyle="{StaticResource EffectText}" Header="Effect" Binding="{Binding Effect}" SortMemberPath="Effect" Width="3*" MinWidth="220" IsReadOnly="True" />
                  <DataGridTextColumn EditingElementStyle="{StaticResource DarkTextBox}" ElementStyle="{StaticResource RarityText}" Header="Rarity" Binding="{Binding Rarity}" SortMemberPath="RarityOrder" Width="110" IsReadOnly="True" />
                  <DataGridTextColumn EditingElementStyle="{StaticResource DarkTextBox}" Header="Roll" Binding="{Binding PerRoll}" SortMemberPath="PerRollValue" Width="90" IsReadOnly="True" />
                  <DataGridTextColumn EditingElementStyle="{StaticResource DarkTextBox}" Header="Next shop" Binding="{Binding NextShop}" SortMemberPath="NextShopValue" Width="100" IsReadOnly="True" />
                  <DataGridTextColumn EditingElementStyle="{StaticResource DarkTextBox}" Header="Price" Binding="{Binding Price}" SortMemberPath="PriceValue" Width="80" IsReadOnly="True" />

                </DataGrid.Columns>
              </DataGrid><TextBlock Style="{StaticResource EmptyResults}" Tag="{Binding ItemRows.Count}"/></Grid>
            </Grid>
          </TabItem>
          <TabItem Header="Trinkets" Tag="&#xE734;">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
              <StackPanel><TextBlock Text="Trinkets" Style="{StaticResource PageTitle}"/><TextBlock Text="Explore effects, availability, and shop odds." Style="{StaticResource PageSubtitle}"/></StackPanel>
              <Border Grid.Row="1" Style="{StaticResource Surface}" Margin="0,16,0,16">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="160"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,12,0"><TextBlock Text="Search trinkets" Style="{StaticResource FieldLabel}"/><TextBox Style="{StaticResource FilterTextBox}" Text="{Binding TrinketSearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search trinkets"/></StackPanel>
                  <StackPanel Grid.Column="1"><TextBlock Text="Rarity" Style="{StaticResource FieldLabel}"/><ComboBox Style="{StaticResource FilterComboBox}" ItemsSource="{Binding RarityFilters}" SelectedItem="{Binding SelectedTrinketRarityFilter}" DisplayMemberPath="Name" AutomationProperties.Name="Trinkets rarity"/></StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding TrinketCount}" Foreground="#BCDDE4" VerticalAlignment="Bottom" Margin="16,0,0,10"/>
                </Grid>
              </Border>
              <Grid Grid.Row="2"><DataGrid ItemsSource="{Binding TrinketRows}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="True" HeadersVisibility="Column" Background="#103F50" Foreground="White" BorderThickness="0" CellStyle="{StaticResource GridCell}" RowStyle="{StaticResource GridRow}" ColumnHeaderStyle="{StaticResource GridHeader}"><DataGrid.Columns>
                <DataGridTemplateColumn Header="Icon" Width="76" CanUserSort="False"><DataGridTemplateColumn.CellTemplate><DataTemplate><Image Source="{Binding SpritePath}" Style="{StaticResource CatalogIcon}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Have" Width="66" SortMemberPath="IsOwned"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" IsEnabled="{Binding IsUnique}" IsChecked="{Binding IsOwned, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Owned unique trinkets are removed from their rarity pool." /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTextColumn EditingElementStyle="{StaticResource DarkTextBox}" Header="Trinket" Binding="{Binding Name}" SortMemberPath="Name" Width="2*" MinWidth="140" IsReadOnly="True" />
                  <DataGridTextColumn EditingElementStyle="{StaticResource DarkTextBox}" ElementStyle="{StaticResource EffectText}" Header="Effect" Binding="{Binding Effect}" SortMemberPath="Effect" Width="3*" MinWidth="220" IsReadOnly="True" /><DataGridTextColumn EditingElementStyle="{StaticResource DarkTextBox}" ElementStyle="{StaticResource RarityText}" Header="Rarity" Binding="{Binding Rarity}" SortMemberPath="RarityOrder" Width="110" IsReadOnly="True" /><DataGridTextColumn EditingElementStyle="{StaticResource DarkTextBox}" Header="Pool" Binding="{Binding PoolCount}" SortMemberPath="PoolCount" Width="58" IsReadOnly="True" /><DataGridTextColumn EditingElementStyle="{StaticResource DarkTextBox}" Header="Chance" Binding="{Binding Chance}" SortMemberPath="ChanceValue" Width="90" IsReadOnly="True" /><DataGridTextColumn EditingElementStyle="{StaticResource DarkTextBox}" Header="Attribute" Binding="{Binding Attribute}" SortMemberPath="Attribute" Width="80" IsReadOnly="True" />
              </DataGrid.Columns></DataGrid><TextBlock Style="{StaticResource EmptyResults}" Tag="{Binding TrinketRows.Count}"/></Grid>
            </Grid>
          </TabItem>
          <TabItem x:Name="GameSetupTab" Header="Game setup" Tag="&#xE713;">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel DataContext="{Binding Setup}" Margin="0,0,4,12">
                <TextBlock Text="Game setup" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Install the companion mod, check readiness, and launch Batomon Showdown." Style="{StaticResource PageSubtitle}" TextWrapping="Wrap"/>
                <Border Style="{StaticResource Surface}" Margin="0,16,0,12"><StackPanel>
                  <TextBlock Text="Battle helper options" Style="{StaticResource SectionTitle}"/>
                  <TextBlock Text="Choose which live battle insights the helper shows. Changes are saved automatically." TextWrapping="Wrap" Foreground="#BCDDE4" Margin="0,0,0,10"/>
                  <CheckBox Content="Show DPS counters" IsChecked="{Binding ShowDpsCounters, Mode=TwoWay}" ToolTip="Show team and enemy damage-per-second counters during battles." Margin="0,4"/>
                  <CheckBox Content="Suggest the best DPS board" IsChecked="{Binding ShowBestDpsBoardSuggestions, Mode=TwoWay}" ToolTip="Show a faster board and bench arrangement when one is found." Margin="0,4"/>
                  <CheckBox Content="Show WIN / LOSS at battle start" IsChecked="{Binding ShowBattleOutcome, Mode=TwoWay}" ToolTip="Show the battle result indicator when the game supplies it." Margin="0,4"/>
                </StackPanel></Border>
                <Border Style="{StaticResource Surface}" Margin="0,0,0,12"><StackPanel>
                  <TextBlock Text="Helper updates" Style="{StaticResource SectionTitle}"/>
                  <TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap" Margin="0,8,0,10"/>
                  <CheckBox Content="Automatically install verified GitHub Releases" IsChecked="{Binding AutoInstallUpdates, Mode=TwoWay}" ToolTip="On startup, download the release installer only after its published SHA-256 checksum is verified." Margin="0,0,0,10"/>
                  <WrapPanel>
                    <Button Content="Check for updates" Command="{Binding CheckForUpdatesCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,8"/>
                    <Button Content="Install update" Command="{Binding InstallUpdateCommand}" IsEnabled="{Binding CanInstallUpdate}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,8"/>
                    <Button Content="Open releases page" Click="OpenReleasesPage" Style="{StaticResource PrimaryButton}" Margin="0,0,10,8"/>
                  </WrapPanel>
                </StackPanel></Border>
                <Border Style="{StaticResource Surface}" Margin="0,16,0,12"><StackPanel>
                  <TextBlock Text="Game folder" Style="{StaticResource SectionTitle}"/>
                  <TextBlock Text="{Binding GameDirectory}" TextWrapping="Wrap" Margin="0,8"/>
                  <WrapPanel><Button Content="Browse…" Command="{Binding BrowseCommand}" IsEnabled="{Binding CanBrowse}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,8"/><Button Content="Check again" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,8"/></WrapPanel>
                  <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8"/>
                  <TextBlock Text="{Binding Connection}" TextWrapping="Wrap" Foreground="#BCDDE4" Margin="0,4,0,12"/>
                  <CheckBox Content="Mod Loader installed and enabled" IsChecked="{Binding LoaderInstalled, Mode=OneWay}" IsHitTestVisible="False" Focusable="False" Margin="0,0,0,10" AutomationProperties.Name="Mod Loader installation status"/>
                  <TextBlock Text="The community Mod Loader is not bundled. Download and extract it, select its folder, then install the mod." TextWrapping="Wrap" Margin="0,0,0,10"/>
                  <WrapPanel>
                    <Button Content="Download Mod Loader" Command="{Binding DownloadLoaderCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,8"/>
                    <Button Content="Select downloaded loader…" Command="{Binding SelectLoaderCommand}" IsEnabled="{Binding CanBrowse}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,8"/>
                  </WrapPanel>
                  <TextBlock Text="{Binding LoaderDirectory}" TextWrapping="Wrap" Foreground="#BCDDE4" Margin="0,0,0,12"/>
                  <WrapPanel>
                    <Button Content="{Binding InstallLabel}" Command="{Binding InstallCommand}" IsEnabled="{Binding CanInstall}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,8"/>
                    <Button Content="Uninstall mod" Command="{Binding UninstallCommand}" IsEnabled="{Binding CanUninstall}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,8"/>
                    <Button Content="Launch game" Command="{Binding LaunchCommand}" IsEnabled="{Binding CanLaunch}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,8"/>
                  </WrapPanel>
                  <TextBlock Text="{Binding Checks}" TextWrapping="Wrap" Foreground="#BCDDE4" Margin="0,0,0,12"/>
                  <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#FFE18B" Margin="0,8"/>
                </StackPanel></Border>
                <TextBlock Text="Close the game before changing mods. Uninstall removes only the helper bridge; the shared Mod Loader stays installed." TextWrapping="Wrap" Foreground="#BCDDE4" Margin="0,8"/>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
        </TabControl>
      </Grid>
      <Border Grid.Row="3" BorderBrush="#4D8C9A" BorderThickness="0,1,0,0" Background="#103F50" Padding="18,8">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="{Binding Status}" FontSize="12" TextWrapping="Wrap"/><TextBlock Text="{Binding RunCaptureStatus}" FontSize="11" Foreground="#BCDDE4" Margin="0,3,0,0"/></StackPanel>

        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
