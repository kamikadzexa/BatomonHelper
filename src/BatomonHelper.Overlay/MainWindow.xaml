<Window x:Class="BatomonHelper.Overlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Batomon Helper" Width="510" Height="540" Topmost="True"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" AllowsTransparency="True" Background="Transparent">
  <Border Background="{StaticResource PanelBackground}" BorderBrush="#536278" BorderThickness="1" CornerRadius="12" Padding="14">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid Grid.Row="0" MouseLeftButtonDown="DragWindow">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock FontWeight="Bold" FontSize="18" Text="Batomon Helper" />
          <TextBlock FontSize="11" Foreground="#AAB7CA" Text="F8 toggles visibility · F9 captures focused shop · external read-only companion" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
          <Button Content="Refresh wiki" Command="{Binding RefreshWikiCommand}" />
          <Button Content="Capture Shop (F9)" Command="{Binding CaptureShopCommand}" />
          <Button Content="Pin" Command="{Binding TogglePinnedCommand}" />
          <Button Content="×" Click="CloseWindow" />
        </StackPanel>
      </Grid>
      <Border Grid.Row="1" Margin="0,12,0,8" Padding="8" Background="#372B1C" CornerRadius="5" Visibility="{Binding WarningVisibility}">
        <TextBlock TextWrapping="Wrap" Foreground="#FFD58B" Text="{Binding Warning}" />
      </Border>
      <StackPanel Grid.Row="2" Margin="0,3,0,8">
        <TextBlock FontWeight="SemiBold" Text="{Binding Status}" />
        <TextBlock FontSize="11" Foreground="#AAB7CA" Text="{Binding Provenance}" />
        <TextBlock FontSize="11" Foreground="#AAB7CA" Text="{Binding RunSummary}" />
      </StackPanel>
      <Grid Grid.Row="3">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock FontWeight="SemiBold" Text="Next fresh shop odds" />
        <DataGrid Grid.Row="1" Margin="0,6,0,0" ItemsSource="{Binding RarityRows}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" Background="#10202E" Foreground="White" BorderThickness="0">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Rarity" Binding="{Binding Name}" Width="*" />
            <DataGridTextColumn Header="Odds" Binding="{Binding Chance}" Width="75" />
            <DataGridTextColumn Header="Eligible" Binding="{Binding Eligible}" Width="70" />
            <DataGridTextColumn Header="Fallback" Binding="{Binding Fallback}" Width="90" />
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="2" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#CBD6E5" Text="{Binding Notes}" />
      </Grid>
      <TextBlock Grid.Row="4" Margin="0,8,0,0" FontSize="10" Foreground="#8290A5" Text="Never reads game memory, writes Steam files, or sends game input." />
    </Grid>
  </Border>
</Window>
