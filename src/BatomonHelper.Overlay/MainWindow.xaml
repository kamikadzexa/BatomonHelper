<Window x:Class="BatomonHelper.Overlay.MainWindow" x:Name="OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Batomon Helper" Icon="pack://application:,,,/BatomonHelper.Overlay;component/Assets/batomon-helper.ico" Width="980" Height="720" MinWidth="720" MinHeight="480" Topmost="True"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" AllowsTransparency="True" Background="Transparent">
  <Window.Resources>
    <Style x:Key="OverlayButton" TargetType="Button">
      <Setter Property="Margin" Value="4,0" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="Foreground" Value="#F7FAFF" />
      <Setter Property="Background" Value="#30465D" />
      <Setter Property="BorderBrush" Value="#7390AE" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#42627F" /><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#9CC8EF" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#78E2B8" /><Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#223447" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Background" Value="#27323E" /><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#465462" /><Setter Property="Foreground" Value="#AAB7CA" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsFullscreen, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True">
          <Setter Property="FontSize" Value="15" />
          <Setter Property="Padding" Value="14,8" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="GridCell" TargetType="DataGridCell"><Setter Property="Background" Value="#10202E" /><Setter Property="Foreground" Value="#F4F8FF" /><Setter Property="BorderBrush" Value="#3C4B5F" /><Setter Property="Padding" Value="10,6" /><Setter Property="FontSize" Value="13" /><Style.Triggers><DataTrigger Binding="{Binding IsFullscreen, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True"><Setter Property="Padding" Value="14,8" /><Setter Property="FontSize" Value="16" /></DataTrigger></Style.Triggers></Style>
    <Style x:Key="GridRow" TargetType="DataGridRow"><Setter Property="Background" Value="#10202E" /><Setter Property="Foreground" Value="#F4F8FF" /><Setter Property="MinHeight" Value="46" /><Style.Triggers><DataTrigger Binding="{Binding IsFullscreen, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True"><Setter Property="MinHeight" Value="62" /></DataTrigger></Style.Triggers></Style>
    <Style x:Key="GridHeader" TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#26384B" /><Setter Property="Foreground" Value="#F4F8FF" /><Setter Property="BorderBrush" Value="#536278" /><Setter Property="Padding" Value="10,7" /><Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="SemiBold" /><Style.Triggers><DataTrigger Binding="{Binding IsFullscreen, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True"><Setter Property="Padding" Value="14,9" /><Setter Property="FontSize" Value="15" /></DataTrigger></Style.Triggers></Style>
    <Style x:Key="CatalogIcon" TargetType="Image"><Setter Property="Width" Value="42" /><Setter Property="Height" Value="42" /><Setter Property="Stretch" Value="Uniform" /><Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="VerticalAlignment" Value="Center" /><Style.Triggers><DataTrigger Binding="{Binding IsFullscreen, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True"><Setter Property="Width" Value="56" /><Setter Property="Height" Value="56" /></DataTrigger></Style.Triggers></Style>
    <Style x:Key="BrowserTabs" TargetType="TabControl">
      <Setter Property="Background" Value="#10202E" /><Setter Property="BorderBrush" Value="#34516A" /><Setter Property="BorderThickness" Value="1" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><Grid KeyboardNavigation.TabNavigation="Local" SnapsToDevicePixels="True"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><TabPanel x:Name="HeaderPanel" IsItemsHost="True" Margin="6,6,6,0" /><Border Grid.Row="1" Margin="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter x:Name="SelectedContentHost" Margin="1" ContentSource="SelectedContent" /></Border></Grid></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="#D9E5F2" /><Setter Property="Background" Value="#203246" /><Setter Property="Padding" Value="16,8" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="FontSize" Value="13" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="#34516A" BorderThickness="1,1,1,0" Padding="{TemplateBinding Padding}" Margin="0,0,3,0"><ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#2C755F" /><Setter Property="Foreground" Value="#FFFFFF" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#42627F" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#718196" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="FilterTextBox" TargetType="TextBox"><Setter Property="Background" Value="#132536" /><Setter Property="Foreground" Value="#F7FAFF" /><Setter Property="CaretBrush" Value="#F7FAFF" /><Setter Property="BorderBrush" Value="#7390AE" /><Setter Property="BorderThickness" Value="1" /><Setter Property="FontSize" Value="13" /><Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#78E2B8" /><Setter Property="BorderThickness" Value="2" /></Trigger><DataTrigger Binding="{Binding IsFullscreen, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True"><Setter Property="FontSize" Value="15" /><Setter Property="Padding" Value="12,7" /></DataTrigger></Style.Triggers></Style>
    <Style x:Key="FilterComboBox" TargetType="ComboBox">
      <Setter Property="Background" Value="#30465D" /><Setter Property="Foreground" Value="#F7FAFF" /><Setter Property="BorderBrush" Value="#7390AE" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="8,4" /><Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton x:Name="Toggle" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" Focusable="False"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="20" /></Grid.ColumnDefinitions><ContentPresenter Margin="0,0,6,0" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" /><Path Grid.Column="1" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 8 0 L 4 5 Z" /></Grid></ToggleButton><Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" PlacementTarget="{Binding ElementName=Toggle}" AllowsTransparency="True" PopupAnimation="Slide"><Border MinWidth="{Binding ActualWidth, ElementName=Toggle}" Margin="0,2,0,0" Background="#1B2D40" BorderBrush="#78E2B8" BorderThickness="1" CornerRadius="4"><ScrollViewer MaxHeight="260" CanContentScroll="True"><ItemsPresenter /></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Toggle" Property="BorderBrush" Value="#78E2B8" /><Setter TargetName="Toggle" Property="BorderThickness" Value="2" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Toggle" Property="Background" Value="#27323E" /><Setter Property="Foreground" Value="#AAB7CA" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#F7FAFF" /><Setter Property="Background" Value="#1B2D40" /><Setter Property="Padding" Value="8,6" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#42627F" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#2C755F" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  </Window.Resources>
  <Border Margin="3" Background="{StaticResource PanelBackground}" BorderBrush="#34516A" BorderThickness="1" CornerRadius="8" Padding="14" SnapsToDevicePixels="True">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border Grid.Row="0" Margin="-4,-4,-4,0" Padding="10,7" Background="#162638" BorderBrush="#34516A" BorderThickness="0,0,0,1" CornerRadius="7,7,0,0">
        <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel x:Name="DragSurface" Background="Transparent" MouseLeftButtonDown="DragWindow">
          <TextBlock FontWeight="Bold" FontSize="21" Text="Batomon Helper" />
          <TextBlock x:Name="VersionLabel" Margin="0,1,0,0" FontSize="10" Foreground="#8495A9" />
          <TextBlock FontSize="12" Foreground="#AAB7CA" Text="Resize freely · F8 toggles visibility · F9 captures focused shop · offline wiki catalog" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
          <Button Style="{StaticResource OverlayButton}" Content="Capture Board (F9)" Command="{Binding CaptureShopCommand}" />
          <Button x:Name="ExpandButton" Style="{StaticResource OverlayButton}" Content="Expand" Click="ToggleExpanded" ToolTip="Toggle a roomy second-screen layout" />
          <Button x:Name="FullscreenButton" Style="{StaticResource OverlayButton}" Content="Fullscreen" Click="ToggleFullscreen" ToolTip="Toggle fullscreen (F11; Escape to exit)" />
          <Button Style="{StaticResource OverlayButton}" Content="×" Click="CloseWindow" ToolTip="Close" />
        </StackPanel>
        </Grid>
      </Border>
      <Border Grid.Row="1" Margin="0,12,0,4" Padding="8" Background="#372B1C" CornerRadius="5" Visibility="{Binding WarningVisibility}"><TextBlock TextWrapping="Wrap" Foreground="#FFD58B" Text="{Binding Warning}" /></Border>
      <Grid Grid.Row="2" Margin="0,8,0,8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox Grid.Column="0" Margin="0,0,8,0" Padding="7,4" Style="{StaticResource FilterTextBox}" ToolTip="Search creature name" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
        <ComboBox Grid.Column="1" Margin="0,0,8,0" Style="{StaticResource FilterComboBox}" ItemsSource="{Binding RegionFilters}" SelectedItem="{Binding SelectedRegionFilter}" DisplayMemberPath="Name" />
        <ComboBox Grid.Column="2" Margin="0,0,8,0" Style="{StaticResource FilterComboBox}" ItemsSource="{Binding RarityFilters}" SelectedItem="{Binding SelectedRarityFilter}" DisplayMemberPath="Name" />
        <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="#AAB7CA" Text="{Binding CreatureCount}" />
        <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="10,0,0,0">
          <CheckBox VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#F4F8FF" Content="Item available" IsChecked="{Binding ItemAvailable, Mode=TwoWay}" ToolTip="When checked, the fifth shop slot is an item." />
          <Button Style="{StaticResource OverlayButton}" Content="−" Command="{Binding DecreaseRankCommand}" ToolTip="Calculate one rank lower" />
          <TextBlock VerticalAlignment="Center" MinWidth="54" TextAlignment="Center" Text="{Binding RankLabel}" />
          <Button Style="{StaticResource OverlayButton}" Content="+" Command="{Binding IncreaseRankCommand}" ToolTip="Calculate one rank higher" />
          <Button Style="{StaticResource OverlayButton}" Content="Reset" Command="{Binding ResetCommand}" ToolTip="Reset browsing to Rank 1 with an item available" />
        </StackPanel>
      </Grid>
      <Border Grid.Row="3" Margin="0,0,0,8" Padding="10,8" Background="#162638" BorderBrush="#34516A" BorderThickness="1" CornerRadius="6">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel Width="128" VerticalAlignment="Center" Margin="0,0,10,0">
            <TextBlock FontWeight="SemiBold" FontSize="14" Text="{Binding ShopOddsLabel}" />
            <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="#AAB7CA" Text="Per Batomon slot" />
          </StackPanel>
          <ItemsControl Grid.Column="1" ItemsSource="{Binding ShopOddsRows}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate>
              <Border Margin="3,0" Padding="9,6" Background="#203246" BorderBrush="#42627F" BorderThickness="1" CornerRadius="4">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="{Binding Rarity}" />
                    <TextBlock Margin="0,2,0,0" FontSize="10" Foreground="#B7C7D9" Text="{Binding PoolDescription}" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="19" FontWeight="Bold" Foreground="#78E2B8" Text="{Binding Percentage}" />
                </Grid>
              </Border>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Border>
      <Grid Grid.Row="4">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding Status}" /><TextBlock FontSize="11" Foreground="#AAB7CA" TextWrapping="Wrap" Text="{Binding RunSummary}" /></StackPanel>
        <TabControl Grid.Row="1" Margin="0,8,0,0" Style="{StaticResource BrowserTabs}">
          <TabControl.Resources>
            <DataTemplate x:Key="BoardCard">
              <Border Background="#203246" BorderBrush="#42627F" BorderThickness="1" CornerRadius="5" Padding="8" Margin="3">
                <Grid MinHeight="68"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                  <Image Source="{Binding SpritePath}" Height="48" Width="48" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" Margin="0,0,8,0" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Level}" Foreground="#FFCE79" Margin="0,0,7,0" FontSize="11" /><TextBlock Text="{Binding Variant}" Foreground="#78E2B8" FontSize="11" /></StackPanel>
                    <TextBlock Text="{Binding Stats}" TextWrapping="Wrap" FontSize="11" />
                    <TextBlock Text="{Binding Price}" TextWrapping="Wrap" Foreground="#B7C7D9" FontSize="12" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </TabControl.Resources>
          <TabItem Header="Board">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="5">
                <Grid Margin="3,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                  <Image Source="{Binding TrainerSpritePath}" Height="64" Width="88" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" Margin="0,0,12,0" />
                  <TextBlock Grid.Column="1" Text="{Binding BoardSummary}" TextWrapping="Wrap" FontSize="16" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="MY TEAM" FontWeight="Bold" Margin="3,10,3,3" Foreground="#FFCE79" />
                <ItemsControl ItemsSource="{Binding TeamRows}" ItemTemplate="{StaticResource BoardCard}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
                <TextBlock Text="BENCH" FontWeight="Bold" Margin="3,10,3,3" Foreground="#FFCE79" />
                <ItemsControl ItemsSource="{Binding BenchRows}" ItemTemplate="{StaticResource BoardCard}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
                <TextBlock Text="SHOP" FontWeight="Bold" Margin="3,10,3,3" Foreground="#FFCE79" />
                <ItemsControl ItemsSource="{Binding OfferRows}" ItemTemplate="{StaticResource BoardCard}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5" /></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="Creatures">
            <DataGrid ItemsSource="{Binding CreatureRows}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="True" HeadersVisibility="Column" Background="#10202E" Foreground="White" BorderThickness="0" CellStyle="{StaticResource GridCell}" RowStyle="{StaticResource GridRow}" ColumnHeaderStyle="{StaticResource GridHeader}">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="Icon" Width="76" CanUserSort="False"><DataGridTemplateColumn.CellTemplate><DataTemplate><Image Source="{Binding SpritePath}" Style="{StaticResource CatalogIcon}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridCheckBoxColumn Header="Lv. 3" Binding="{Binding IsLevelThree, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SortMemberPath="IsLevelThree" Width="66" />
                <DataGridTextColumn Header="Creature" Binding="{Binding Name}" SortMemberPath="Name" Width="2*" IsReadOnly="True" />
                <DataGridTextColumn Header="Rarity" Binding="{Binding Rarity}" SortMemberPath="RarityOrder" Width="125" IsReadOnly="True" />
                <DataGridTextColumn Header="Region" Binding="{Binding Regions}" SortMemberPath="Regions" Width="180" IsReadOnly="True" />
                <DataGridTextColumn Header="Roll" Binding="{Binding PerRoll}" SortMemberPath="PerRollValue" Width="90" IsReadOnly="True" />
                <DataGridTextColumn Header="Next shop" Binding="{Binding NextShop}" SortMemberPath="NextShopValue" Width="100" IsReadOnly="True" />
              </DataGrid.Columns>
            </DataGrid>
          </TabItem>
          <TabItem Header="Items">
            <Grid Margin="0,6,0,0">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <DockPanel Margin="0,0,0,6"><TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="#AAB7CA" Text="{Binding ItemCount}" /><ComboBox DockPanel.Dock="Right" Width="145" Margin="0,0,8,0" Style="{StaticResource FilterComboBox}" ItemsSource="{Binding RarityFilters}" SelectedItem="{Binding SelectedItemRarityFilter}" DisplayMemberPath="Name" ToolTip="Filter items by rarity" /><TextBox Margin="0,0,8,0" Padding="7,4" Style="{StaticResource FilterTextBox}" ToolTip="Search item name" Text="{Binding ItemSearchText, UpdateSourceTrigger=PropertyChanged}" /></DockPanel>
              <DataGrid Grid.Row="1" ItemsSource="{Binding ItemRows}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="True" HeadersVisibility="Column" Background="#10202E" Foreground="White" BorderThickness="0" CellStyle="{StaticResource GridCell}" RowStyle="{StaticResource GridRow}" ColumnHeaderStyle="{StaticResource GridHeader}">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="Icon" Width="76" CanUserSort="False"><DataGridTemplateColumn.CellTemplate><DataTemplate><Image Source="{Binding SpritePath}" Style="{StaticResource CatalogIcon}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTextColumn Header="Item" Binding="{Binding Name}" SortMemberPath="Name" Width="2*" IsReadOnly="True" />
                  <DataGridTextColumn Header="Rarity" Binding="{Binding Rarity}" SortMemberPath="RarityOrder" Width="110" IsReadOnly="True" />
                  <DataGridTextColumn Header="Roll" Binding="{Binding PerRoll}" SortMemberPath="PerRollValue" Width="90" IsReadOnly="True" />
                  <DataGridTextColumn Header="Next shop" Binding="{Binding NextShop}" SortMemberPath="NextShopValue" Width="100" IsReadOnly="True" />
                  <DataGridTextColumn Header="Price" Binding="{Binding Price}" SortMemberPath="PriceValue" Width="80" IsReadOnly="True" />
                  <DataGridTextColumn Header="Effect" Binding="{Binding Effect}" SortMemberPath="Effect" Width="3*" IsReadOnly="True" />
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </TabItem>
          <TabItem Header="Trinkets">
            <Grid Margin="0,6,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <DockPanel Margin="0,0,0,6"><TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="#AAB7CA" Text="{Binding TrinketCount}" /><ComboBox DockPanel.Dock="Right" Width="145" Margin="0,0,8,0" Style="{StaticResource FilterComboBox}" ItemsSource="{Binding RarityFilters}" SelectedItem="{Binding SelectedTrinketRarityFilter}" DisplayMemberPath="Name" ToolTip="Filter trinkets by rarity" /><TextBox Margin="0,0,8,0" Padding="7,4" Style="{StaticResource FilterTextBox}" ToolTip="Search trinket name" Text="{Binding TrinketSearchText, UpdateSourceTrigger=PropertyChanged}" /></DockPanel>
              <DataGrid Grid.Row="1" ItemsSource="{Binding TrinketRows}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="True" HeadersVisibility="Column" Background="#10202E" Foreground="White" BorderThickness="0" CellStyle="{StaticResource GridCell}" RowStyle="{StaticResource GridRow}" ColumnHeaderStyle="{StaticResource GridHeader}"><DataGrid.Columns>
                <DataGridTemplateColumn Header="Icon" Width="76" CanUserSort="False"><DataGridTemplateColumn.CellTemplate><DataTemplate><Image Source="{Binding SpritePath}" Style="{StaticResource CatalogIcon}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Have" Width="66" SortMemberPath="IsOwned"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" IsEnabled="{Binding IsUnique}" IsChecked="{Binding IsOwned, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Owned unique trinkets are removed from their rarity pool." /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTextColumn Header="Trinket" Binding="{Binding Name}" SortMemberPath="Name" Width="2*" IsReadOnly="True" /><DataGridTextColumn Header="Rarity" Binding="{Binding Rarity}" SortMemberPath="RarityOrder" Width="110" IsReadOnly="True" /><DataGridTextColumn Header="Pool" Binding="{Binding PoolCount}" SortMemberPath="PoolCount" Width="58" IsReadOnly="True" /><DataGridTextColumn Header="Chance" Binding="{Binding Chance}" SortMemberPath="ChanceValue" Width="90" IsReadOnly="True" /><DataGridTextColumn Header="Attribute" Binding="{Binding Attribute}" SortMemberPath="Attribute" Width="80" IsReadOnly="True" /><DataGridTextColumn Header="Effect" Binding="{Binding Effect}" SortMemberPath="Effect" Width="3*" IsReadOnly="True" />
              </DataGrid.Columns></DataGrid>
            </Grid>
          </TabItem>
        </TabControl>
      </Grid>
      <TextBlock Grid.Row="5" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#CBD6E5" Text="{Binding Notes}" />
    </Grid>
  </Border>
</Window>
