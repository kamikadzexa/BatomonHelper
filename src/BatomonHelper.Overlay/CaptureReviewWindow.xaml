<Window x:Class="BatomonHelper.Overlay.CaptureReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm shop details" Icon="pack://application:,,,/Assets/batomon-helper.ico" Width="1180" Height="780" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="#10202E" Foreground="#F4F8FF">
  <Window.Resources>
    <Style x:Key="ReviewValue" TargetType="TextBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#F7FAFF" />
      <Setter Property="CaretBrush" Value="#F7FAFF" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="BorderBrush" Value="#7390AE" />
      <Setter Property="FontSize" Value="28" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Padding" Value="0,3,0,5" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#78E2B8" /><Setter Property="BorderThickness" Value="0,0,0,2" /></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="ReviewButton" TargetType="Button">
      <Setter Property="Padding" Value="20,10" /><Setter Property="Margin" Value="10,0,0,0" />
      <Setter Property="Foreground" Value="#F7FAFF" /><Setter Property="Background" Value="#30465D" /><Setter Property="BorderBrush" Value="#7390AE" /><Setter Property="BorderThickness" Value="1" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="FontSize" Value="15" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#42627F" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#223447" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid Margin="18">
    <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
    <Border Background="#162638" BorderBrush="#34516A" BorderThickness="1" CornerRadius="8" Padding="6" Margin="0,0,16,0">
      <Image Source="{Binding Image}" Stretch="Uniform" />
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel>
        <TextBlock FontSize="25" FontWeight="Bold" Text="Confirm shop details" />
        <TextBlock Margin="0,5,0,0" TextWrapping="Wrap" Foreground="#AAB7CA" FontSize="14" Text="Check the values below, make any changes you need, then save this shop." />
      </StackPanel>
      <ScrollViewer Grid.Row="1" Margin="0,18,0,14" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Fields}">
          <ItemsControl.ItemTemplate><DataTemplate>
            <Border Margin="0,0,0,10" Padding="14,11" Background="#203246" BorderBrush="#42627F" BorderThickness="1" CornerRadius="6">
              <StackPanel>
                <TextBlock Foreground="#B7C7D9" FontSize="13" FontWeight="SemiBold" Text="{Binding DisplayName}" />
                <TextBox Style="{StaticResource ReviewValue}" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
            </Border>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <DockPanel Grid.Row="2">
        <TextBlock VerticalAlignment="Center" Foreground="#AAB7CA" Text="Your shop details will be saved after you confirm." />
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Style="{StaticResource ReviewButton}" Content="Back" IsCancel="True" />
          <Button Style="{StaticResource ReviewButton}" Background="#2C755F" BorderBrush="#78E2B8" Content="Save shop" IsDefault="True" Click="Accept_Click" />
        </StackPanel>
      </DockPanel>
    </Grid>
  </Grid>
</Window>
