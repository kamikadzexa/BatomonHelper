<Window x:Class="BatomonHelper.Overlay.CaptureReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review shop capture" Width="1120" Height="760" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="14">
    <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
    <Border BorderBrush="#536278" BorderThickness="1" CornerRadius="5" Padding="4" Margin="0,0,12,0">
      <Image Source="{Binding Image}" Stretch="Uniform" />
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock TextWrapping="Wrap" Foreground="#4E5D6D" Text="Review the shop rank, gold, and item-use amounts. Ribbon odds are generated from the standard rank table. The selected Jinto/Pantra region filter is retained with the capture and limits the eligible pool. Correct any uncertain values before acceptance. The screenshot is retained locally only after this dialog closes." />
      <DataGrid Grid.Row="1" Margin="0,10,0,10" ItemsSource="{Binding Fields}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Field" Binding="{Binding Name}" IsReadOnly="True" Width="130" />
          <DataGridTextColumn Header="Value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*" />
          <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence, StringFormat={}{0:P0}}" IsReadOnly="True" Width="82" />
          <DataGridTextColumn Header="Candidates / issue" Binding="{Binding Detail}" IsReadOnly="True" Width="170" />
        </DataGrid.Columns>
      </DataGrid>
      <DockPanel Grid.Row="2">
        <TextBlock Text="{Binding Diagnostics}" Foreground="#A24629" TextWrapping="Wrap" VerticalAlignment="Center" />
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="Cancel" IsCancel="True" Padding="14,6" Margin="8,0,0,0" />
          <Button Content="Accept capture" IsDefault="True" Click="Accept_Click" Padding="14,6" Margin="8,0,0,0" />
        </StackPanel>
      </DockPanel>
    </Grid>
  </Grid>
</Window>
