<Window x:Class="BatomonHelper.Overlay.ShoppingSettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Local advice settings" Width="540" Height="430" WindowStartupLocation="CenterOwner" Background="#162638" Foreground="#F4F8FF">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="22">
  <TextBlock Text="Local model" FontSize="20" FontWeight="Bold" />
  <TextBlock Text="Model name" Margin="0,12,0,4" /><TextBox x:Name="ModelBox" Style="{StaticResource DarkTextBox}" />
  <TextBlock Text="Local Ollama endpoint" Margin="0,10,0,4" /><TextBox x:Name="EndpointBox" Style="{StaticResource DarkTextBox}" />
  <TextBlock Text="Context tokens (4096–32768)" Margin="0,10,0,4" /><TextBox x:Name="ContextBox" Style="{StaticResource DarkTextBox}" />
  <CheckBox x:Name="ThinkingBox" Content="Enable model thinking (slower)" Margin="0,12,0,4" Foreground="#F4F8FF" />
  <TextBlock x:Name="ErrorText" Foreground="#FFD58B" TextWrapping="Wrap" />
  <Button Content="Save settings" Click="Save_Click" Margin="0,14" Padding="12,8" />
 </StackPanel></ScrollViewer>
</Window>
