<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\batomon-helper.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="..\..\third-party-licenses\*" Link="third-party-licenses\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets\batomon-helper.ico" />
    <Resource Include="Assets\batomon-helper-logo.png" />
    <ProjectReference Include="..\BatomonHelper.Core\BatomonHelper.Core.csproj" />
    <ProjectReference Include="..\BatomonHelper.Simulation\BatomonHelper.Simulation.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\README.md" Link="README.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\LICENSE.txt" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\docs\*.md" Link="docs\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\docs\images\*.png" Link="docs\images\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\simulation\rules.json" Link="assets\simulation\rules.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\mods\BatomonHelperBridge\**\*" Link="mods\BatomonHelperBridge\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\tools\Install-GameBridge.ps1" Link="tools\Install-GameBridge.ps1" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\wiki\**\*">
      <Link>assets\wiki\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
